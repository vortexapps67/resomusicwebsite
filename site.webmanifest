{
  "name": "Reso Music",
  "short_name": "Reso",
  "description": "An offline music player for the files already on your device.",
  "start_url": "index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f0b08",
  "theme_color": "#0f0b08",
  "icons": [
    { "src": "assets/favicon-16x16.png", "sizes": "16x16", "type": "image/png" },
    { "src": "assets/favicon-32x32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "assets/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/favicon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
  ]
}
